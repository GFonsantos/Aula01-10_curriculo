:root{
  --ink:#1a1a1a;
  --mut:#5a5a5a;
  --line:#e2e2e2;
  --acc:#0b5fff;
  --bg:#ffffff;
  --soft:#f7f8fa;
}
*{box-sizing:border-box;}
body{
  font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color:var(--ink);
  background:var(--soft);
  margin:0;
  padding:32px 16px;
  line-height:1.55;
  font-size:15px;
}
.page{
  max-width:900px;
  margin:0 auto;
  background:var(--bg);
  padding:48px 56px;
  box-shadow:0 10px 40px rgba(0,0,0,.08);
  border-radius:6px;
}
header{
  border-bottom:3px solid var(--ink);
  padding-bottom:18px;
  margin-bottom:28px;
}
.header-flex{
  display:flex;
  align-items:center;
  gap:22px;
}
.header-text{flex:1;}
.avatar{
  width:110px;
  height:110px;
  border-radius:50%;
  object-fit:cover;
  border:3px solid var(--acc);
  flex-shrink:0;
}
header h1{
  margin:0 0 6px 0;
  font-size:30px;
  letter-spacing:.5px;
  font-weight:700;
}
header .role{
  font-size:15px;
  color:var(--acc);
  font-weight:600;
  margin-bottom:10px;
}
header .contact{
  font-size:13.5px;
  color:var(--mut);
  display:flex;
  flex-wrap:wrap;
  gap:6px 18px;
}
header .contact span{white-space:nowrap;}
h2{
  font-size:13px;
  text-transform:uppercase;
  letter-spacing:1.6px;
  color:var(--ink);
  border-bottom:1px solid var(--line);
  padding-bottom:6px;
  margin:30px 0 16px 0;
  font-weight:700;
}
h3{
  font-size:15px;
  margin:0 0 2px 0;
  font-weight:700;
}
.meta{
  font-size:13px;
  color:var(--mut);
  margin-bottom:8px;
}
.item{margin-bottom:18px;}
.item:last-child{margin-bottom:0;}
ul{
  margin:6px 0 0 0;
  padding-left:18px;
}
li{margin-bottom:4px;}
.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:6px 32px;
}
.skill{
  display:flex;
  justify-content:space-between;
  border-bottom:1px dotted var(--line);
  padding:4px 0;
  font-size:14px;
}
.skill span:last-child{color:var(--mut);}
.tags{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:6px;
}
.tag{
  background:var(--soft);
  border:1px solid var(--line);
  border-radius:14px;
  padding:3px 11px;
  font-size:12.5px;
  color:var(--ink);
}
.summary{
  background:var(--soft);
  border-left:3px solid var(--acc);
  padding:14px 18px;
  font-size:14.5px;
  color:#333;
  margin-bottom:6px;
}
footer{
  margin-top:36px;
  padding-top:14px;
  border-top:1px solid var(--line);
  font-size:12px;
  color:var(--mut);
  text-align:center;
}
@media (max-width:640px){
  .page{padding:28px 22px;}
  .grid{grid-template-columns:1fr;}
  header h1{font-size:24px;}
  .header-flex{flex-direction:column;text-align:center;gap:14px;}
  .avatar{width:96px;height:96px;}
}
@media print{
  body{background:#fff;padding:0;font-size:12.5px;}
  .page{box-shadow:none;border-radius:0;padding:0;max-width:100%;}
  h2{margin:18px 0 10px 0;}
  .item{margin-bottom:12px;}
}